{
  "name": "playmcp",
  "version": "3.0.0",
  "description": "MCP server for browser automation with Playwright: navigate, interact, extract content and capture screenshots.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "browser-automation",
    "web-scraping"
  ],
  "homepage": "https://github.com/jomon003/PlayMCP#readme",
  "bugs": {
    "url": "https://github.com/jomon003/PlayMCP/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomon003/PlayMCP.git"
  },
  "license": "MIT",
  "author": "jomon003",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "playmcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/tools.test.js test/stdio.test.js",
    "install-browser": "playwright install chromium",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run clean && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
